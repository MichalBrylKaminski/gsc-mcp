# Required (or MCP_AUTH_TOKENS, or OAuth sign-in below). Bearer token the Grok bot sends. Generate with: openssl rand -hex 32
MCP_AUTH_TOKEN=

# Optional. More tokens, comma-separated, as name:token or bare tokens; the name shows in the logs.
# One token per client lets you revoke one, and rotate without downtime (see README, Rotating credentials).
# MCP_AUTH_TOKENS=grok:...,claude-code:...

# Optional. true: each token must end in :YYYY-MM-DD and stops working at 00:00 UTC that day.
# Create dated tokens with: node dist/issueToken.js <name>  (date = today + MCP_AUTH_TOKEN_TTL_DAYS, 30-365, default 90)
# MCP_AUTH_AUTO_EXPIRE=false
# MCP_AUTH_TOKEN_TTL_DAYS=90

# Optional. OAuth sign-in: clients get and renew their own tokens after you approve them with a Google
# sign-in (see README, OAuth sign-in). On only when all four are set; then MCP_AUTH_TOKEN(S) become optional.
# MCP_PUBLIC_URL=https://gsc-mcp.example.com
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# MCP_OAUTH_ALLOWED_EMAILS=you@example.com
# Number of reverse proxies in front of the server that append to X-Forwarded-For (e.g. 2 for Cloudflare + nginx),
# for the sign-in rate limits. Never more than the real number; 0 = none. nginx must use $proxy_add_x_forwarded_for.
# If ALLOWED_HOSTS is set, it must include the host of MCP_PUBLIC_URL.
# TRUST_PROXY=

# Path to the service-account JSON key. docker-compose sets this to the mounted secret.
# For local development: GOOGLE_APPLICATION_CREDENTIALS=./secrets/gsc-sa.json
# GOOGLE_APPLICATION_CREDENTIALS=

# Optional. Comma-separated hostnames to accept in the Host header (DNS-rebinding protection), e.g. gsc-mcp.example.com.
# Bare hostnames only (no https:// or path); ports are ignored. Behind nginx, also set `proxy_set_header Host $host;`.
# ALLOWED_HOSTS=

# Optional. Comma-separated properties the bot may read. Default: every property the service account can see.
# GSC_ALLOWED_SITES=https://www.example.com/,sc-domain:example.org

# Fraction of Google's published limits to use locally (0-1). Default 0.8.
# QUOTA_SAFETY_FACTOR=0.8
# How long a call may wait for a free rate-limit slot before failing. Default 15000.
# MAX_QUEUE_WAIT_MS=15000
# Max parallel Google API calls. Default 4.
# MAX_CONCURRENCY=4
# Max rows one search_analytics_query call may return. Default 25000, max 50000. (fetchAll returns 5000 unless maxRows asks for more.)
# GSC_MAX_ROWS_PER_CALL=25000
# CACHE_ENABLED=true
# LOG_LEVEL=info
# PORT=3000
# HOST_PORT=3000

# Optional. Path of the MCP endpoint (default /mcp), e.g. /gsc-mcp when published under that path.
# MCP_PATH=/mcp
