# Required. Bearer token the Grok bot sends. Generate with: openssl rand -hex 32
MCP_AUTH_TOKEN=

# Path to the service-account JSON key. docker-compose sets this to the mounted secret.
# For local development: GOOGLE_APPLICATION_CREDENTIALS=./secrets/gsc-sa.json
# GOOGLE_APPLICATION_CREDENTIALS=

# Optional. Comma-separated hostnames to accept in the Host header (DNS-rebinding protection), e.g. gsc-mcp.example.com.
# Bare hostnames only (no https:// or path); ports are ignored. Behind nginx, also set `proxy_set_header Host $host;`.
# ALLOWED_HOSTS=

# Optional. Comma-separated properties the bot may read. Default: every property the service account can see.
# GSC_ALLOWED_SITES=https://www.example.com/,sc-domain:example.org

# Fraction of Google's published limits to use locally (0-1). Default 0.8.
# QUOTA_SAFETY_FACTOR=0.8
# How long a call may wait for a free rate-limit slot before failing. Default 15000.
# MAX_QUEUE_WAIT_MS=15000
# Max parallel Google API calls. Default 4.
# MAX_CONCURRENCY=4
# Max rows one search_analytics_query call may return (with fetchAll). Default 25000, max 50000.
# GSC_MAX_ROWS_PER_CALL=25000
# CACHE_ENABLED=true
# LOG_LEVEL=info
# PORT=3000
# HOST_PORT=3000
