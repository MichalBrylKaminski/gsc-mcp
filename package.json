{
  "name": "gsc-mcp",
  "version": "0.1.0",
  "description": "Read-only Google Search Console MCP server (Streamable HTTP)",
  "license": "MIT",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@googleapis/searchconsole": "11.0.1",
    "@modelcontextprotocol/sdk": "1.32.2",
    "express": "5.3.0",
    "google-auth-library": "11.3.3",
    "lru-cache": "11.5.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "26.6.6",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
